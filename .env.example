# NOFX 环境变量模板
# 复制为 .env 并按需修改

# ===========================================
# 数据库 (SQLite，本地模拟账本)
# ===========================================
DB_TYPE=sqlite
DB_PATH=data/data.db

# ===========================================
# AI 决策 (必填)
# ===========================================
# provider: deepseek / openai / claude / qwen / gemini / grok / kimi / minimax
# 或任意自定义名 + AI_BASE_URL（OpenAI 兼容端点，如智谱 https://open.bigmodel.cn/api/paas/v4）
AI_PROVIDER=deepseek
# 留空则使用 provider 默认模型
AI_MODEL=
# 留空则使用 provider 默认端点
AI_BASE_URL=
# 直接填 key，或使用 provider 对应的常规变量 (如 DEEPSEEK_API_KEY)
AI_API_KEY=
# 单次回复最大 token（思考型模型建议调大，如 8000）
AI_MAX_TOKENS=

# ===========================================
# Telegram 推送 (可选；不填则只写日志不推送)
# 1. 找 @BotFather 创建 bot 拿到 token
# 2. 给 bot 发一条消息后访问
#    https://api.telegram.org/bot<token>/getUpdates 拿到 chat_id
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# 交易模式
# ===========================================
# paper = 本地模拟账本（默认，无需交易所 key）
# live  = OKX 真实账户（强烈建议先配 OKX_DEMO=1 走模拟盘验证）
TRADING_MODE=paper

# ===========================================
# OKX 实盘/demo（仅 TRADING_MODE=live 时需要）
# 在 OKX 网页「API 管理」创建 API Key，交易权限勾选「交易」
# ===========================================
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = OKX 模拟盘 (demo trading)，0 = 实盘
OKX_DEMO=1
# 1 = 全仓（默认），0 = 逐仓
OKX_ISOLATED=0

# ===========================================
# 模拟交易参数
# ===========================================
# 初始本金 (USDT)，仅在首次建账时生效
INITIAL_BALANCE=1000
# 交易周期秒数 (最小 30)
SCAN_INTERVAL=300

# ===========================================
# 行情源 (OKX 公开 REST，无需 API key)
# ===========================================
OKX_BASE_URL=https://www.okx.com

# ===========================================
# 出站代理 (可选 — OKX 行情 / Telegram / AI 请求都走它)
# 留空则直连；也可用标准 HTTPS_PROXY 环境变量
# ===========================================
PROXY_URL=
